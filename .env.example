# TypeSafe Jev. Required for real runs. https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Explain backend: claude_cli | claude_api | fake
CLIPSIEVE_EXPLAIN_BACKEND=claude_cli
CLIPSIEVE_CLAUDE_BIN=claude
CLIPSIEVE_CLAUDE_MAX_BUDGET_USD=3

# Only for CLIPSIEVE_EXPLAIN_BACKEND=claude_api
ANTHROPIC_API_KEY=

# Optional. Improves YouTube search recall.
YOUTUBE_API_KEY=

# Where runs, media and the SQLite index live. A relative path resolves against the repo root.
CLIPSIEVE_DATA_DIR=./data

# Per-install salt for creator hashing. Generated on first run if empty.
CLIPSIEVE_CREATOR_SALT=

# contrib/adapter-xhs-mediacrawler: Chrome remote debugging port
CLIPSIEVE_XHS_CHROME_CDP_PORT=9222
# Path to your MediaCrawler checkout; relative paths resolve against the repo root.
CLIPSIEVE_XHS_MEDIACRAWLER_DIR=../MediaCrawler
# Seconds before a MediaCrawler search run is killed. Keep non-empty.
CLIPSIEVE_XHS_TIMEOUT_S=900
# all | video. "video" keeps only video notes; image notes are dropped before anything is stored.
CLIPSIEVE_XHS_NOTE_KINDS=all
# Max search pages per query, both runners (api: one search plus one detail request per note;
# mediacrawler: one full crawl of two to three minutes).
CLIPSIEVE_XHS_MAX_PAGES=10
# api | mediacrawler. "api" calls the web API with your browser's cookies (fast, video-only
# search); "mediacrawler" drives the MediaCrawler checkout below (fallback).
CLIPSIEVE_XHS_RUNNER=api
# api runner: also fetch the first page of comments per note (one extra request each).
CLIPSIEVE_XHS_COMMENTS=0
# api runner: seconds between requests; raise it if runs hit "访问频次异常" (300012).
CLIPSIEVE_XHS_REQUEST_INTERVAL_S=1.0
# api runner: notes per search request (platform maximum 20).
CLIPSIEVE_XHS_PAGE_SIZE=20

# Frontend dev server: origin of the FastAPI backend for the /api rewrite (default http://localhost:8000)
CLIPSIEVE_API_ORIGIN=

# Tests, fake mode and the Playwright flow only: a fixture dir (backend/tests/fixtures) served as
# the `local` platform instead of folder/CSV import. Leave empty for real runs.
CLIPSIEVE_FIXTURE_DIR=

# TypeSafe Jev. Required for real runs. https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Explain backend: claude_cli | claude_api | fake
CLIPSIEVE_EXPLAIN_BACKEND=claude_cli
CLIPSIEVE_CLAUDE_BIN=claude
CLIPSIEVE_CLAUDE_MAX_BUDGET_USD=3

# Only for CLIPSIEVE_EXPLAIN_BACKEND=claude_api
ANTHROPIC_API_KEY=

# Optional. Improves YouTube search recall.
YOUTUBE_API_KEY=

# Where runs, media and the SQLite index live. A relative path resolves against the repo root.
CLIPSIEVE_DATA_DIR=./data

# Per-install salt for creator hashing. Generated on first run if empty.
CLIPSIEVE_CREATOR_SALT=

# contrib/adapter-xhs-mediacrawler: Chrome remote debugging port
CLIPSIEVE_XHS_CHROME_CDP_PORT=9222

# Frontend dev server: origin of the FastAPI backend for the /api rewrite (default http://localhost:8000)
CLIPSIEVE_API_ORIGIN=

# Tests, fake mode and the Playwright flow only: a fixture dir (backend/tests/fixtures) served as
# the `local` platform instead of folder/CSV import. Leave empty for real runs.
CLIPSIEVE_FIXTURE_DIR=

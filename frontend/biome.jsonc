{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": "//",
  "files": {
    "includes": ["**", "!src/components/ui", "!src/lib/types.ts"]
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "filenameCases": ["kebab-case", "camelCase", "PascalCase"]
          }
        }
      }
    }
  }
}

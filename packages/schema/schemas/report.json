{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipsieve.dev/schema/report.json",
  "title": "Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "patterns", "clips", "gaps", "concepts", "caveats"],
  "properties": {
    "run_id": { "type": "string" },
    "patterns": { "type": "array", "items": { "$ref": "#/$defs/Pattern" } },
    "clips": {
      "type": "array",
      "items": { "$ref": "#/$defs/ClipExplanation" }
    },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/Gap" } },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/Concept" } },
    "caveats": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "Pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "observation", "hypothesis", "post_ids"],
      "properties": {
        "title": { "type": "string" },
        "observation": { "type": "string" },
        "hypothesis": { "type": "string" },
        "post_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ClipExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post_id", "why_it_works", "hook_quote", "weaknesses"],
      "properties": {
        "post_id": { "type": "string" },
        "why_it_works": { "type": "string" },
        "hook_quote": { "type": "string" },
        "weaknesses": { "type": "string" }
      }
    },
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rationale", "post_ids"],
      "properties": {
        "title": { "type": "string" },
        "rationale": { "type": "string" },
        "post_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook",
        "structure",
        "visual",
        "proof",
        "cta",
        "inspired_by_post_ids"
      ],
      "properties": {
        "hook": { "type": "string" },
        "structure": { "type": "string" },
        "visual": { "type": "string" },
        "proof": { "type": "string" },
        "cta": { "type": "string" },
        "inspired_by_post_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
